# Copiá este archivo como `.env` en la raíz del proyecto.
# pgAdmin: creá una base (ej. bitcycle) y pegá la cadena de conexión.

DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/bitcycle

# Credenciales configurables para los dos perfiles de demo (contraseñas de 12+ caracteres).
BITCYCLE_OPERATOR_USERNAME= op
BITCYCLE_OPERATOR_PASSWORD= sanjose
BITCYCLE_ADMIN_USERNAME= ad
BITCYCLE_ADMIN_PASSWORD= bitcycle

# Secreto aleatorio de sesión de al menos 32 caracteres. No lo subas a Git.
BITCYCLE_SESSION_SECRET= bitcycle-secret-aleatorio-de-32-caracteres

# URL pública del sitio para las vistas previas Open Graph en producción.
# Configurala también en las variables de entorno de Vercel.
# VITE_SITE_URL=https://tu-dominio.com

# Opcional: puerto del servidor de desarrollo (por defecto 5173)
# PORT=5173
